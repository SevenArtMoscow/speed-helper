# Скопировать в server/.env и заполнить. Файл .env в git не коммитить.
PORT=3000
DATABASE_URL=postgres://speedhelper:PASSWORD@127.0.0.1:5432/speedhelper
# Токен бота от @BotFather
TG_BOT_TOKEN=
# Длинная случайная строка: openssl rand -hex 32
JWT_SECRET=
# Адрес мини-приложения (для кнопок бота)
APP_URL=https://speedhelper.ru
# Telegram ID владельцев через запятую — станут админами
ADMIN_TG_IDS=
